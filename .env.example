# Copy to .env.local and fill in. Every variable below is one the application
# actually reads (see src/lib/env.ts) — there are no others. The app has no
# service-role key and no server-only secret of any kind: every query runs as
# the signed-in user's own session under RLS, and anonymous visitors read
# published rows through the anon key. Do not add a secret here.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both values come from Supabase project settings > API, and both are public:
# the anon key is designed to ship to the browser, and RLS is what restricts
# access, not the key.
#
# The URL below is a PLACEHOLDER and is not a real project — replace the ref
# deliberately with the project you intend to use. It is left unresolvable on
# purpose so that copying this file can never silently point local
# development at a live production database.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin used for canonical URLs, Open Graph URLs and the sitemap.
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact ─────────────────────────────────────────────────────────────────
# Optional, and deliberately unset by default. The contact page renders a
# real address only when this holds one; with no value it says so plainly
# rather than publishing a placeholder inbox nobody reads. Leave it unset
# until a monitored address exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Analytics ───────────────────────────────────────────────────────────────
# Both optional and both public (they are meant to be read off the page).
# Neither is a credential, but leave them unset until there is a real property
# to point at — with no measurement ID, no analytics script loads, no requests
# are made, and no Google origins are added to the Content-Security-Policy.

# GA4 measurement ID, e.g. G-XXXXXXXXXX. Analytics runs cookieless: no _ga
# cookie, no advertising signals, and page URLs are reported without their
# query string so search terms are never sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification token — the content value of
# the google-site-verification meta tag, not the whole tag. Setting this only
# renders the tag; the property still has to be verified inside Search Console
# against the live domain, which cannot happen before deployment.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Monitoring ──────────────────────────────────────────────────────────────
# All optional. Errors are captured and logged as structured JSON whether or
# not any of these are set — these only add deployment context and remote
# forwarding.

# Which deployment this is, so production incidents aren't mixed in with
# preview or local ones. Defaults to NODE_ENV when unset.
# Example values: production, preview, development
NEXT_PUBLIC_APP_ENV=

# Release identifier, so an error can be traced to the exact build. Set this
# to the commit SHA in the deployment pipeline (Step 7.12). Defaults to
# "unversioned".
NEXT_PUBLIC_APP_VERSION=

# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never commit a real value.
# HTTPS endpoint of an error-monitoring provider. When set, redacted error
# reports are POSTed here; when unset, they are logged locally only, which is
# why development does not need this and will not flood anything.
MONITORING_DSN=
