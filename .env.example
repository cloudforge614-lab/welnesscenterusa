# Public (safe to expose to the browser) — from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://prnqrokairwfttwypmyg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public. Absolute origin used for canonical/OG URLs and the sitemap. Defaults
# to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER import in a Client Component.
# Used only for: revalidation webhook auth, and any future narrowly-scoped
# server-side admin task that must bypass RLS. All normal owner/agency writes
# go through the authenticated user's own session, not this key.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the Postgres publish webhook sends to /api/revalidate.
REVALIDATE_SECRET=
